# Copie para .env (ignorado pelo Git). O CLI carrega .env sem sobrescrever variáveis da sessão.
# Nunca faça commit de chaves. O modo observe sem flags não chama APIs.
TYPESAFE_API_KEY=
# OpenAI: OPENAI_API_KEY também é aceita como VLM_API_KEY.
OPENAI_API_KEY=
# API multimodal: base HTTPS antes de /chat/completions, modelo e chave do provedor.
# Não há provedor/modelo escolhido por padrão nem fallback de inferência local.
VLM_BASE_URL=
VLM_MODEL=
VLM_API_KEY=
